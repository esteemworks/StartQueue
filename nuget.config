<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The compiled EsteemWorks.Kit lives in kit\, next to nuget.org. -->
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="esteemworks-kit" value="kit" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="esteemworks-kit">
      <package pattern="EsteemWorks.Kit" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
