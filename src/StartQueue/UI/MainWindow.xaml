<Window x:Class="StartQueue.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:StartQueue.UI"
        xmlns:s="clr-namespace:StartQueue"
        xmlns:kit="clr-namespace:EsteemWorks.Kit.UI;assembly=EsteemWorks.Kit"
        Title="StartQueue" Width="1140" Height="740" MinWidth="920" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text2}"
        FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        >


    <Window.Resources>
        <!-- Row menu: right click on a row, the ⋯ button, or "More actions" in the details; the buttons open it as menu
             buttons of the kit (KitMenuButton), the row is chosen as it opens -->
        <ContextMenu x:Key="RowMenu" x:Shared="False">
            <MenuItem Header="{x:Static s:Strings.MenuStart}" Tag="&#xE768;" InputGestureText="{x:Static s:Strings.KeyEnter}" Click="Menu_Start" />
            <MenuItem Header="{Binding ToggleLabel}" Tag="&#xE7E8;" InputGestureText="{x:Static s:Strings.KeySpace}" Click="Menu_Toggle" />
            <Separator />
            <MenuItem Header="{x:Static s:Strings.MenuUp}" Tag="&#xE70E;" InputGestureText="{x:Static s:Strings.KeyAltUp}" Click="Menu_Up" />
            <MenuItem Header="{x:Static s:Strings.MenuDown}" Tag="&#xE70D;" InputGestureText="{x:Static s:Strings.KeyAltDown}" Click="Menu_Down" />
            <MenuItem Header="{x:Static s:Strings.MenuTop}" Tag="&#xE74A;" Click="Menu_Top" />
            <MenuItem Header="{x:Static s:Strings.MenuEnd}" Tag="&#xE74B;" Click="Menu_End" />
            <Separator />
            <MenuItem Header="{x:Static s:Strings.ShowFile}" Tag="&#xE838;" Click="Menu_ShowFile" IsEnabled="{Binding HasFileLocation}" />
            <MenuItem Header="{x:Static s:Strings.ReturnToWindows}" Tag="&#xE7A7;" Click="Menu_Return" IsEnabled="{Binding HasOrigin}" />
            <Separator />
            <MenuItem Header="{x:Static s:Strings.Remove}" Tag="&#xE74D;" InputGestureText="{x:Static s:Strings.KeyDel}" Click="Menu_Remove"
                      Style="{StaticResource DangerMenuItem}" />
        </ContextMenu>

        <!-- Profile menu: right click on a profile in the profile bar -->
        <ContextMenu x:Key="ProfileMenu" x:Shared="False">
            <MenuItem Header="{x:Static s:Strings.ProfileEdit}" Tag="&#xE70F;" Click="ProfileMenu_Edit" />
            <MenuItem Header="{Binding PauseLabel}" Tag="&#xE769;" Click="ProfileMenu_Pause" />
            <Separator />
            <!-- By hand, for every app that uses the profile: up to the end of its hours or until switched back -->
            <MenuItem Header="{Binding UseUntilLabel}" Tag="&#xE768;" Click="ProfileMenu_UseUntil"
                      Visibility="{Binding CanUseUntil, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem Header="{x:Static s:Strings.ProfileUseOpen}" Tag="&#xE768;" Click="ProfileMenu_UseOpen" />
            <Separator />
            <MenuItem Header="{x:Static s:Strings.ProfileEarlier}" Tag="&#xE76B;" Click="ProfileMenu_Earlier" IsEnabled="{Binding CanMoveLeft}" />
            <MenuItem Header="{x:Static s:Strings.ProfileLater}" Tag="&#xE76C;" Click="ProfileMenu_Later" IsEnabled="{Binding CanMoveRight}" />
            <Separator />
            <MenuItem Header="{x:Static s:Strings.ProfileDelete}" Tag="&#xE74D;" Click="ProfileMenu_Delete" Style="{StaticResource DangerMenuItem}" />
        </ContextMenu>

        <Style x:Key="EntryItem" TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
            <Setter Property="ContextMenu" Value="{StaticResource RowMenu}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDragging}" Value="True">
                    <Setter Property="Opacity" Value="0.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Add dialog rows -->
        <DataTemplate DataType="{x:Type ui:AddHeader}">
            <StackPanel Orientation="Horizontal" Margin="0,20,0,8" HorizontalAlignment="Left" ToolTip="{Binding Hint}">
                <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding Title}" />
                <TextBlock Style="{StaticResource InfoGlyph}" FontSize="11" Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ui:AddNote}">
            <TextBlock Style="{StaticResource Muted}" Text="{Binding Text}" Margin="0,4,0,4" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type ui:CandidateVm}">
            <Border x:Name="Card" Height="52" Margin="0,0,0,6" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource Line}" Background="{DynamicResource Surface}" Padding="12,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding Icon}" Width="28" Height="28" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text1}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Grid Grid.Column="3" Width="148" Margin="12,0,0,0">
                        <!-- One primary per view: Done is the dialog's; each row's Add is a secondary button -->
                        <Button Style="{StaticResource SecondaryButton}" Content="{x:Static s:Strings.Add}" FontSize="13" Padding="0"
                                Click="AddCandidate_Click" Visibility="{Binding CanAdd, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding DoneText}" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock.Style>
                                <!-- "Added" just now: accent; "already in StartQueue": a quiet note -->
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Foreground" Value="{DynamicResource Text4}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Added}" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSuggestion}" Value="False">
                    <Setter TargetName="Card" Property="Height" Value="44" />
                    <Setter TargetName="Card" Property="Margin" Value="0" />
                    <Setter TargetName="Card" Property="BorderThickness" Value="0" />
                    <Setter TargetName="Card" Property="Background" Value="Transparent" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSuggestion}" Value="False" />
                        <Condition Binding="{Binding IsMouseOver, ElementName=Card}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource PopHover}" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsAddedSuggestion}" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource Selected}" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource SelectedLine}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- The family's window (kit KitFrame): title bar, title with the line of facts, the actions (the main one
             last), the tabs with the gear, the brand line, and at the first start the introduction. Tabs in code. -->
        <kit:KitFrame x:Name="Frame">
            <kit:KitFrame.Actions>
                <!-- Only shown when something needs a look; a click goes there -->
                <Button x:Name="StatusChip" Height="32" Margin="0,0,8,0" Cursor="Hand" Visibility="Collapsed" Click="Status_Click"
                        AutomationProperties.Name="{Binding Text, ElementName=StatusText}"
                        Background="{DynamicResource WarnChipBg}" Foreground="{DynamicResource WarnChipText}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="12,0,12,0">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource WarnChipText}" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE76C;" FontSize="10" Margin="8,1,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="ScanButton" Style="{StaticResource HeroButton}" Click="Scan_Click" Margin="0,0,8,0"
                        ToolTip="{x:Static s:Strings.ScanTip}" AutomationProperties.Name="{x:Static s:Strings.Scan}">
                    <StackPanel Orientation="Horizontal">
                        <!-- Turns while a scan runs -->
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72C;" FontSize="14" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="ScanTurn" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock Text="{x:Static s:Strings.Scan}" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="AddButton" Style="{StaticResource PrimaryButton}" Click="Add_Click"
                        ToolTip="{x:Static s:Strings.AddAppTip}" AutomationProperties.Name="{x:Static s:Strings.AddApp}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Static s:Strings.AddApp}" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </kit:KitFrame.Actions>

        <!-- ========== Startup order ========== -->
        <Grid x:Name="OrderView">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <DockPanel Margin="24,16,12,20">
                <!-- Profiles: the frame for the list below. Left to right in order of precedence, Standard last. -->
                <Border DockPanel.Dock="Top" Margin="0,0,24,16" Padding="16,12" CornerRadius="8" Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource Line}" BorderThickness="1">
                    <StackPanel>
                        <WrapPanel Orientation="Horizontal" ToolTip="{x:Static s:Strings.ProfileBarTip}">
                            <TextBlock Style="{StaticResource SectionLabel}" Text="{x:Static s:Strings.ProfileBarLabel}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Grid>
                                <ItemsControl x:Name="ProfileTabs" Focusable="False" AllowDrop="True" Background="Transparent"
                                              DragOver="ProfileTabs_DragOver" Drop="ProfileTabs_Drop" DragLeave="ProfileTabs_DragLeave">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton GroupName="ShownProfile" IsChecked="{Binding IsShown, Mode=OneWay}" Click="ProfileTab_Click" ToolTip="{Binding Tip}"
                                                     AutomationProperties.Name="{Binding Name}"
                                                     PreviewMouseLeftButtonDown="ProfileTab_PreviewMouseDown" PreviewMouseMove="ProfileTab_PreviewMouseMove">
                                            <RadioButton.Style>
                                                <Style TargetType="RadioButton" BasedOn="{StaticResource ProfileChip}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCustom}" Value="True">
                                                            <Setter Property="ContextMenu" Value="{StaticResource ProfileMenu}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </RadioButton.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <!-- The profile's color; the profile that applies now gets a ring around it -->
                                                <Grid Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <Ellipse Width="8" Height="8" Fill="{Binding Swatch}" />
                                                    <Ellipse Stroke="{Binding Swatch}" StrokeThickness="1.5" ToolTip="{x:Static s:Strings.ProfileActiveNow}"
                                                             Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                                                </Grid>
                                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE769;" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"
                                                           Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                                <!-- Where a dragged profile will land: an upright line with a dot in the gap between chips -->
                                <Canvas x:Name="ProfileDropLayer" IsHitTestVisible="False">
                                    <Grid x:Name="ProfileDropMarker" Width="10" Visibility="Collapsed">
                                        <Border Width="2" CornerRadius="1" Background="{DynamicResource AccentFill}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                        <Ellipse Width="10" Height="10" VerticalAlignment="Top" Stroke="{DynamicResource AccentFill}" StrokeThickness="2" Fill="{DynamicResource Surface}" />
                                    </Grid>
                                </Canvas>
                            </Grid>
                            <Button Style="{StaticResource GhostButton}" Height="30" Click="ProfileAdd_Click" ToolTip="{x:Static s:Strings.ProfilesIntro}"
                                    AutomationProperties.Name="{x:Static s:Strings.ProfileAdd}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Static s:Strings.ProfileAddShort}" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <Grid x:Name="ProfileInfoRow" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ProfileCondition" Style="{StaticResource Help}" FontSize="13" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                                <Button x:Name="ProfileScheduleButton" Style="{StaticResource QuietButton}" Height="28" Margin="0,0,4,0" Click="ProfileSchedule_Click"
                                        Content="{x:Static s:Strings.ProfileBackToSchedule}" ToolTip="{x:Static s:Strings.ProfileBackToScheduleTip}" Visibility="Collapsed" />
                                <Button x:Name="ProfileOrderButton" Style="{StaticResource QuietButton}" Height="28" Margin="0,0,4,0" Click="ProfileOrder_Click"
                                        Content="{x:Static s:Strings.ProfileOrderShort}" ToolTip="{x:Static s:Strings.ProfileOrderTip}" />
                                <Button x:Name="ProfilePauseButton" Style="{StaticResource QuietButton}" Height="28" Click="ShownProfilePause_Click" />
                                <Button x:Name="ProfilePauseEditButton" Style="{StaticResource QuietButton}" Height="28" Margin="4,0,0,0"
                                        Content="{x:Static s:Strings.ProfilePauseEdit}" Click="ShownProfilePauseEdit_Click" />
                                <Button x:Name="ProfileEditButton" Style="{StaticResource QuietButton}" Height="28" Margin="4,0,0,0"
                                        Content="{x:Static s:Strings.ProfileEdit}" Click="ShownProfileEdit_Click" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid DockPanel.Dock="Top" Height="32" Margin="0,0,24,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" ToolTip="{x:Static s:Strings.OrderHint}">
                        <TextBlock Style="{StaticResource SectionLabel}" Text="{x:Static s:Strings.OrderLabel}" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource InfoGlyph}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                        <Button x:Name="MarkSeenButton" Style="{StaticResource QuietButton}" Content="{x:Static s:Strings.AllSeen}" Click="MarkSeen_Click" />
                        <Button Style="{StaticResource QuietButton}" Content="{x:Static s:Strings.StartAllNow}" Click="RunSequence_Click" Margin="4,0,0,0"
                                ToolTip="{x:Static s:Strings.RunSequenceTip}" />
                    </StackPanel>
                </Grid>

                <Grid>
                    <ListBox x:Name="EntryList" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource EntryItem}" AllowDrop="True"
                             VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Recycling"
                             AutomationProperties.Name="{x:Static s:Strings.TabOrder}"
                             KeyboardNavigation.TabNavigation="Continue"
                             SelectionChanged="EntryList_SelectionChanged"
                             PreviewMouseLeftButtonDown="EntryList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="EntryList_PreviewMouseMove"
                             DragOver="EntryList_DragOver" Drop="EntryList_Drop" DragLeave="EntryList_DragLeave"
                             KeyDown="EntryList_KeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type ui:EntryVm}">
                                <Grid Height="54">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE784;" FontSize="12" Foreground="{DynamicResource Text4}"
                                               Cursor="SizeAll" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{x:Static s:Strings.DragTip}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Position}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text4}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled}" Margin="6,0,16,0"
                                              ToolTip="{x:Static s:Strings.StartAtLogon}" AutomationProperties.Name="{x:Static s:Strings.StartAtLogon}" />

                                    <Grid Grid.Column="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                        <Setter Property="Opacity" Value="0.55" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Image Source="{Binding Icon}" Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text1}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource Text4}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subtitle}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Settings of the entry in neutral chips; only "still with Windows" (Windows starts it too) and New carry color -->
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,12,0">
                                        <Border Style="{StaticResource Chip}" Visibility="{Binding StillInWindows, Converter={StaticResource BoolToVisibility}}" ToolTip="{x:Static s:Strings.StillInWindowsTip}">
                                            <TextBlock Style="{StaticResource ChipLabel}" Text="{x:Static s:Strings.StillInWindowsChip}" />
                                        </Border>
                                        <Border Style="{StaticResource NewChip}" Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}" ToolTip="{x:Static s:Strings.NewChipTip}">
                                            <TextBlock Style="{StaticResource NewChipLabel}" Text="{x:Static s:Strings.NewChip}" />
                                        </Border>
                                        <Border Style="{StaticResource Chip}" Visibility="{Binding HasDelay, Converter={StaticResource BoolToVisibility}}" ToolTip="{x:Static s:Strings.DelayTip}">
                                            <TextBlock Style="{StaticResource ChipLabel}" Foreground="{DynamicResource Text3}" Text="{Binding DelayText}" />
                                        </Border>
                                        <Border Style="{StaticResource Chip}" Visibility="{Binding WaitUntilRunning, Converter={StaticResource BoolToVisibility}}" ToolTip="{x:Static s:Strings.WaitsTip}">
                                            <TextBlock Style="{StaticResource ChipLabel}" Foreground="{DynamicResource Text3}" Text="{x:Static s:Strings.WaitsChip}" />
                                        </Border>
                                        <Border Style="{StaticResource Chip}" Visibility="{Binding RunElevated, Converter={StaticResource BoolToVisibility}}" ToolTip="{x:Static s:Strings.AdminTip}">
                                            <TextBlock Style="{StaticResource ChipLabel}" Foreground="{DynamicResource Text3}" Text="{x:Static s:Strings.AdminChip}" />
                                        </Border>
                                        <Border Style="{StaticResource Chip}" Visibility="{Binding HasWindowChip, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding WindowNote}">
                                            <TextBlock Style="{StaticResource ChipLabel}" Foreground="{DynamicResource Text3}" Text="{Binding WindowChip}" />
                                        </Border>
                                        <Border Style="{StaticResource Chip}" Visibility="{Binding HasRepeat, Converter={StaticResource BoolToVisibility}}" ToolTip="{x:Static s:Strings.RepeatHelp}">
                                            <TextBlock Style="{StaticResource ChipLabel}" Foreground="{DynamicResource Text3}" Text="{Binding RepeatText}" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Grid.Column="5" Text="{Binding LastStartText}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               ToolTip="{Binding LastStartLong}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Text4}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LastStartFailed}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource ErrorText}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <StackPanel Grid.Column="6" Style="{StaticResource RowActions}" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <Button Style="{StaticResource RowAction}" Content="&#xE768;" Click="StartNow_Click"
                                                ToolTip="{x:Static s:Strings.StartNow}" AutomationProperties.Name="{x:Static s:Strings.StartNow}" />
                                        <Button Style="{StaticResource RowAction}" Content="&#xE74D;" Click="RowRemove_Click" Margin="2,0"
                                                ToolTip="{x:Static s:Strings.Remove}" AutomationProperties.Name="{x:Static s:Strings.Remove}" />
                                        <Button Style="{StaticResource RowAction}" Content="&#xE712;" ContextMenu="{StaticResource RowMenu}" kit:KitMenuButton.Enabled="True"
                                                ToolTip="{x:Static s:Strings.MoreActions}" AutomationProperties.Name="{x:Static s:Strings.MoreActions}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Where a dragged row will land: a line with a dot in the gap between rows -->
                    <Canvas x:Name="DropLayer" IsHitTestVisible="False" ClipToBounds="True">
                        <Grid x:Name="DropMarker" Height="10" Visibility="Collapsed">
                            <Border Height="2" CornerRadius="1" Background="{DynamicResource AccentFill}" VerticalAlignment="Center" Margin="5,0,0,0" />
                            <Ellipse Width="10" Height="10" HorizontalAlignment="Left" Stroke="{DynamicResource AccentFill}" StrokeThickness="2" Fill="{DynamicResource Bg}" />
                        </Grid>
                    </Canvas>

                    <StackPanel x:Name="EmptyOrder" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource H2}" Text="{x:Static s:Strings.EmptyTitle}" TextAlignment="Center" />
                        <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,8,0,0" Text="{x:Static s:Strings.EmptyText}" />
                    </StackPanel>
                </Grid>
            </DockPanel>

            <!-- Details -->
            <Border Grid.Column="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
                <Grid>
                    <TextBlock x:Name="NoSelection" Style="{StaticResource Muted}" Margin="32" VerticalAlignment="Center" TextAlignment="Center"
                               Text="{x:Static s:Strings.NoSelection}" />
                    <!-- Scroll areas stop short of the window edge, so nothing is cut off right at it -->
                    <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Margin="0,0,4,20">
                        <StackPanel x:Name="Detail" Margin="24,24,24,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding Icon}" Width="40" Height="40" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                <!-- The name first; its kind a quiet line below, no capitals line above the title -->
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource H2}" Text="{Binding Name}" />
                                    <TextBlock Style="{StaticResource Muted}" Text="{Binding KindLabel}" />
                                </StackPanel>
                            </Grid>

                            <Border Background="{DynamicResource NoticeBg}" CornerRadius="8" Padding="12,10" Margin="0,16,0,0"
                                    Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding NewText}" Foreground="{DynamicResource NoticeText}" TextWrapping="Wrap" FontSize="13" />
                            </Border>

                            <TextBlock Style="{StaticResource SectionLabel}" Text="{x:Static s:Strings.SectionStartup}" Margin="0,24,0,12" />
                            <Grid Margin="0,0,0,16">
                                <TextBlock Style="{StaticResource RowLabel}" Text="{x:Static s:Strings.StartAtLogon}" VerticalAlignment="Center" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled}" HorizontalAlignment="Right"
                                          AutomationProperties.Name="{x:Static s:Strings.StartAtLogon}" />
                            </Grid>
                            <!-- Which profile this switch belongs to -->
                            <TextBlock x:Name="DetailProfileNote" Style="{StaticResource Help}" Margin="0,-12,0,16" Visibility="Collapsed" />
                            <Grid Margin="0,0,0,16">
                                <TextBlock Style="{StaticResource RowLabel}" Text="{x:Static s:Strings.DelayShort}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBox Style="{StaticResource FieldBox}" Width="64" Text="{Binding DelaySeconds, UpdateSourceTrigger=LostFocus}"
                                             KeyDown="CommitOnEnter" AutomationProperties.Name="{x:Static s:Strings.DelayName}" />
                                    <TextBlock Text="{x:Static s:Strings.SecondsShort}" Width="30" Margin="8,0,0,0" FontSize="13" Foreground="{DynamicResource Text3}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{x:Static s:Strings.WaitHelpShort}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="{x:Static s:Strings.WaitUntilRunning}" />
                                    <TextBlock Style="{StaticResource InfoGlyph}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding WaitUntilRunning}" VerticalAlignment="Center"
                                          AutomationProperties.Name="{x:Static s:Strings.WaitUntilRunning}" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding AdminHelp}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="{x:Static s:Strings.RunElevated}" />
                                    <TextBlock Style="{StaticResource InfoGlyph}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding RunElevated}" VerticalAlignment="Center"
                                          IsEnabled="{Binding AdminAvailable}" AutomationProperties.Name="{x:Static s:Strings.RunElevated}" />
                            </Grid>
                            <Grid Margin="0,16,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" ToolTip="{x:Static s:Strings.RepeatHelp}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="{x:Static s:Strings.Repeat}" />
                                    <TextBlock Style="{StaticResource InfoGlyph}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBox Style="{StaticResource FieldBox}" Width="64" Text="{Binding RepeatMinutes, UpdateSourceTrigger=LostFocus}"
                                             KeyDown="CommitOnEnter" AutomationProperties.Name="{x:Static s:Strings.RepeatName}" />
                                    <TextBlock Text="{x:Static s:Strings.MinutesShort}" Width="30" Margin="8,0,0,0" FontSize="13" Foreground="{DynamicResource Text3}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,8" HorizontalAlignment="Left" ToolTip="{Binding WindowNote}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="{x:Static s:Strings.StartWindow}" />
                                <TextBlock Style="{StaticResource InfoGlyph}" />
                            </StackPanel>
                            <!-- Three equal segments across the panel; fixed when a shortcut or task decides, or there is no window -->
                            <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Stretch" IsEnabled="{Binding WindowEditable}" ToolTip="{Binding WindowNote}" ToolTipService.ShowOnDisabled="True">
                                <UniformGrid kit:KitKeys.Roving="True" Rows="1">
                                    <RadioButton Style="{StaticResource FirstSegment}" Width="Auto" GroupName="StartWindow" Content="{x:Static s:Strings.WindowNormal}" IsChecked="{Binding WindowNormal}" />
                                    <RadioButton Style="{StaticResource Segment}" Width="Auto" GroupName="StartWindow" Content="{x:Static s:Strings.WindowMinimized}" IsChecked="{Binding WindowMinimized}" />
                                    <RadioButton Style="{StaticResource Segment}" Width="Auto" GroupName="StartWindow" Content="{x:Static s:Strings.WindowBackground}" IsChecked="{Binding WindowBackground}"
                                                 IsEnabled="{Binding CanBackground}" />
                                </UniformGrid>
                            </Border>
                            <!-- Only a fact stays visible (a start parameter, a minimized shortcut, no window); explanations are in the tooltip -->
                            <TextBlock Style="{StaticResource Help}" Text="{Binding WindowFact}" Margin="0,6,0,0" Visibility="{Binding HasWindowFact, Converter={StaticResource BoolToVisibility}}" />

                            <!-- Own start parameters: as before, added to the app's own ones, or in their place -->
                            <Grid Margin="0,24,0,8">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="{x:Static s:Strings.SectionParameters}" VerticalAlignment="Center" />
                                <Button Style="{StaticResource QuietButton}" Height="24" Padding="8,0" HorizontalAlignment="Right" Click="ParametersInfo_Click"
                                        ToolTip="{Binding ParametersHelp}" AutomationProperties.Name="{x:Static s:Strings.ParamHowItWorks}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE946;" FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Static s:Strings.ParamHowItWorks}" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Stretch">
                                <UniformGrid kit:KitKeys.Roving="True" Rows="1">
                                    <RadioButton Style="{StaticResource FirstSegment}" Width="Auto" GroupName="Parameters" Content="{x:Static s:Strings.ParamAsBefore}" IsChecked="{Binding ParamAsBefore}"
                                                 ToolTip="{x:Static s:Strings.ParamAsBeforeTip}" />
                                    <RadioButton Style="{StaticResource Segment}" Width="Auto" GroupName="Parameters" Content="{x:Static s:Strings.ParamAdd}" IsChecked="{Binding ParamAdd}"
                                                 ToolTip="{x:Static s:Strings.ParamAddTip}" />
                                    <RadioButton Style="{StaticResource Segment}" Width="Auto" GroupName="Parameters" Content="{x:Static s:Strings.ParamReplace}" IsChecked="{Binding ParamReplace}"
                                                 ToolTip="{x:Static s:Strings.ParamReplaceTip}" />
                                </UniformGrid>
                            </Border>
                            <StackPanel Visibility="{Binding ParamAsBefore, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource Help}" Text="{x:Static s:Strings.ParamCurrent}" Margin="0,12,0,4" />
                                <TextBlock Style="{StaticResource Value}" Text="{Binding OriginalArguments}" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding ParamAdd, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource Help}" Text="{x:Static s:Strings.ParamCurrentFixed}" Margin="0,12,0,4" />
                                <TextBox Style="{StaticResource FieldBox}" Text="{Binding OriginalArguments, Mode=OneWay}" IsReadOnly="True" Opacity="0.65"
                                         AutomationProperties.Name="{x:Static s:Strings.ParamCurrentFixed}" />
                                <TextBlock Style="{StaticResource Help}" Text="{x:Static s:Strings.ParamExtra}" Margin="0,12,0,4" />
                                <TextBox Style="{StaticResource FieldBox}" Text="{Binding ExtraArguments, UpdateSourceTrigger=LostFocus}" KeyDown="CommitOnEnter"
                                         AutomationProperties.Name="{x:Static s:Strings.ParamExtra}" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding ParamReplace, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource Help}" Text="{x:Static s:Strings.ParamOwn}" Margin="0,12,0,4" />
                                <TextBox Style="{StaticResource FieldBox}" Text="{Binding OwnArguments, UpdateSourceTrigger=LostFocus}" KeyDown="CommitOnEnter"
                                         AutomationProperties.Name="{x:Static s:Strings.ParamOwn}" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding HasEffectiveCommand, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource Help}" Text="{x:Static s:Strings.ParamRuns}" Margin="0,12,0,4" />
                                <TextBlock Style="{StaticResource Value}" Text="{Binding EffectiveCommand}" />
                            </StackPanel>
                            <Grid Margin="0,24,0,8">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="{x:Static s:Strings.SectionWhat}" VerticalAlignment="Center" />
                                <Button x:Name="EditButton" Style="{StaticResource QuietButton}" Content="{x:Static s:Strings.EditDetails}" Height="24" Padding="8,0"
                                        HorizontalAlignment="Right" Click="Edit_Click" />
                            </Grid>
                            <TextBlock x:Name="WhatText" Style="{StaticResource Value}" Text="{Binding Subtitle}" />
                            <StackPanel x:Name="EditPanel" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource Help}" Text="{x:Static s:Strings.Name}" Margin="0,4,0,4" />
                                <TextBox Style="{StaticResource FieldBox}" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" KeyDown="CommitOnEnter"
                                         AutomationProperties.Name="{x:Static s:Strings.Name}" />
                                <StackPanel Visibility="{Binding IsProgram, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource Help}" Text="{x:Static s:Strings.Program}" Margin="0,12,0,4" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Style="{StaticResource FieldBox}" Text="{Binding Target, UpdateSourceTrigger=LostFocus}" KeyDown="CommitOnEnter"
                                                 AutomationProperties.Name="{x:Static s:Strings.Program}" />
                                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE838;" Margin="6,0,0,0" Click="Browse_Click"
                                                ToolTip="{x:Static s:Strings.ChooseProgram}" AutomationProperties.Name="{x:Static s:Strings.ChooseProgram}" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource Help}" Text="{x:Static s:Strings.StartIn}" Margin="0,12,0,4" />
                                    <TextBox Style="{StaticResource FieldBox}" Text="{Binding WorkingDirectory, UpdateSourceTrigger=LostFocus}" KeyDown="CommitOnEnter"
                                             AutomationProperties.Name="{x:Static s:Strings.StartIn}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,4" HorizontalAlignment="Left" ToolTip="{x:Static s:Strings.ProcessNameHelp}">
                                    <TextBlock Style="{StaticResource Help}" Text="{x:Static s:Strings.ProcessName}" />
                                    <TextBlock Style="{StaticResource InfoGlyph}" FontSize="11" />
                                </StackPanel>
                                <TextBox Style="{StaticResource FieldBox}" Text="{Binding ProcessName, UpdateSourceTrigger=LostFocus}" KeyDown="CommitOnEnter"
                                         AutomationProperties.Name="{x:Static s:Strings.ProcessName}" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource SectionLabel}" Text="{x:Static s:Strings.SectionLastLogon}" Margin="0,20,0,8" />
                            <TextBlock Style="{StaticResource Value}" Text="{Binding LastStartLong}" />

                            <TextBlock Style="{StaticResource SectionLabel}" Text="{x:Static s:Strings.SectionOrigin}" Margin="0,20,0,8" />
                            <TextBlock Style="{StaticResource Value}" Text="{Binding OriginText}" />

                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                <Button Style="{StaticResource SecondaryButton}" Click="StartNow_Click" AutomationProperties.Name="{x:Static s:Strings.StartNow}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE768;" FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Static s:Strings.StartNow}" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource QuietButton}" Content="{x:Static s:Strings.MoreActions}" Margin="8,0,0,0"
                                        ContextMenu="{StaticResource RowMenu}" kit:KitMenuButton.Enabled="True" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ========== Windows autostart ========== -->
        <DockPanel x:Name="WindowsView" Margin="32,16,20,20" Visibility="Collapsed">
            <Grid DockPanel.Dock="Top" Height="32" Margin="0,0,24,16">
                <TextBlock x:Name="WindowsHintText" Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{x:Static s:Strings.WindowsHintTip}" />
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,24,0">
                    <!-- Each section has its own "take over all", so it is clear what it applies to -->
                    <Grid Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SectionLabel}" Text="{x:Static s:Strings.SectionStartsItself}" />
                            <TextBlock x:Name="WindowsCount" Style="{StaticResource SectionLabel}" Margin="8,0,0,0" />
                        </StackPanel>
                        <Button x:Name="TakeOverAllButton" Style="{StaticResource GhostButton}" Content="{x:Static s:Strings.TakeOverAll}" HorizontalAlignment="Right"
                                Click="TakeOverAll_Click" ToolTip="{x:Static s:Strings.TakeOverAllEntriesTip}" />
                    </Grid>
                    <TextBlock x:Name="WindowsLoading" Style="{StaticResource Muted}" Text="{x:Static s:Strings.Scanning}" Margin="0,4,0,0" />
                    <TextBlock x:Name="WindowsEmpty" Style="{StaticResource Muted}" Text="{x:Static s:Strings.WindowsEmpty}" Margin="0,4,0,0" Visibility="Collapsed" />
                    <ItemsControl x:Name="WindowsList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type ui:WindowsItemVm}">
                                <Border Height="56" Margin="0,0,0,6" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Line}"
                                        Background="{DynamicResource Surface}" Padding="16,0,12,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding Icon}" Width="28" Height="28" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text1}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Origin}" FontSize="12" Foreground="{DynamicResource Text4}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Origin}" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource Chip}" Width="140" Margin="12,0" ToolTip="{Binding StatusTip}">
                                            <!-- Neutral for every kind: the color of a chip never tells the origin -->
                                            <TextBlock Style="{StaticResource ChipLabel}" Foreground="{DynamicResource Text3}" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <Button Grid.Column="3" Style="{StaticResource SecondaryButton}" Width="148" FontSize="13" Padding="0"
                                                IsEnabled="{Binding CanTakeOver}" Click="TakeOverOne_Click"
                                                AutomationProperties.Name="{Binding ButtonText}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xEA18;" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"
                                                           Visibility="{Binding ShowShield, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Text="{Binding ButtonText}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,16,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" ToolTip="{x:Static s:Strings.TasksHintTakeOver}">
                            <TextBlock Style="{StaticResource SectionLabel}" Text="{x:Static s:Strings.SectionLogonTasks}" />
                            <TextBlock x:Name="TasksCount" Style="{StaticResource SectionLabel}" Margin="8,0,0,0" />
                            <TextBlock Style="{StaticResource InfoGlyph}" FontSize="11" />
                        </StackPanel>
                        <Button x:Name="TakeOverAllTasksButton" Style="{StaticResource GhostButton}" Content="{x:Static s:Strings.TakeOverAll}" HorizontalAlignment="Right"
                                Click="TakeOverAllTasks_Click" ToolTip="{x:Static s:Strings.TakeOverAllTasksTip}" />
                    </Grid>
                    <TextBlock x:Name="TasksEmpty" Style="{StaticResource Muted}" Text="{x:Static s:Strings.NoLogonTasks}" Visibility="Collapsed" />
                    <ItemsControl x:Name="TasksList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type ui:TaskItemVm}">
                                <Border Height="56" Margin="0,0,0,6" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Line}"
                                        Background="{DynamicResource Surface}" Padding="16,0,12,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="148" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding Icon}" Width="28" Height="28" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text1}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource Text4}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource Chip}" Width="140" Margin="12,0" ToolTip="{Binding StatusTip}">
                                            <TextBlock Style="{StaticResource ChipLabel}" Foreground="{DynamicResource Text3}" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <Button Grid.Column="3" Style="{StaticResource SecondaryButton}" FontSize="13" Padding="0" Click="TakeOverTask_Click"
                                                Visibility="{Binding CanTakeOver, Converter={StaticResource BoolToVisibility}}"
                                                AutomationProperties.Name="{x:Static s:Strings.TakeOver}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xEA18;" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"
                                                           Visibility="{Binding ShowShield, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Text="{x:Static s:Strings.TakeOver}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- ========== Services: shown and changed like in services.msc, never taken over ========== -->
        <DockPanel x:Name="ServicesView" Margin="32,16,20,20" Visibility="Collapsed">
            <Grid DockPanel.Dock="Top" Margin="0,0,24,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <!-- The kit's search field: Esc clears, Ctrl+F finds it -->
                    <kit:SearchBox x:Name="ServicesSearch" Width="300" Placeholder="{x:Static s:Strings.ServicesSearch}" TextChanged="ServicesSearch_TextChanged" />
                    <!-- Sorted the same way in both sections -->
                    <ComboBox x:Name="ServicesSortBox" Width="190" Height="32" Margin="8,0,0,0" FontSize="13" SelectedIndex="0" SelectionChanged="ServicesSort_Changed"
                              AutomationProperties.Name="{x:Static s:Strings.ServicesSort}" ToolTip="{x:Static s:Strings.ServicesSort}">
                        <ComboBoxItem Content="{x:Static s:Strings.ServicesSortName}" />
                        <ComboBoxItem Content="{x:Static s:Strings.ServicesSortStart}" />
                        <ComboBoxItem Content="{x:Static s:Strings.ServicesSortState}" />
                    </ComboBox>
                    <!-- Start types and state to show; several at once, the menu stays open while ticking. The value is the
                         CommandParameter: Tag is a menu entry's icon in the kit -->
                    <Button x:Name="ServicesFilterButton" Style="{StaticResource SecondaryButton}" Height="32" Margin="8,0,0,0" kit:KitMenuButton.Enabled="True"
                            ToolTip="{x:Static s:Strings.ServicesFilterTip}" AutomationProperties.Name="{Binding Text, ElementName=ServicesFilterText}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE71C;" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock x:Name="ServicesFilterText" Text="{x:Static s:Strings.ServicesFilter}" Margin="8,0,0,0" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="ServicesFilterMenu">
                                <MenuItem Header="{x:Static s:Strings.ServiceStartType}" IsEnabled="False" />
                                <MenuItem Header="{x:Static s:Strings.StartAutomatic}" CommandParameter="Automatic" IsCheckable="True" StaysOpenOnClick="True" Click="ServicesFilterItem_Click" />
                                <MenuItem Header="{x:Static s:Strings.StartDelayed}" CommandParameter="AutomaticDelayed" IsCheckable="True" StaysOpenOnClick="True" Click="ServicesFilterItem_Click" />
                                <MenuItem Header="{x:Static s:Strings.StartManual}" CommandParameter="Manual" IsCheckable="True" StaysOpenOnClick="True" Click="ServicesFilterItem_Click" />
                                <MenuItem Header="{x:Static s:Strings.StartDisabled}" CommandParameter="Disabled" IsCheckable="True" StaysOpenOnClick="True" Click="ServicesFilterItem_Click" />
                                <Separator />
                                <MenuItem Header="{x:Static s:Strings.ServicesFilterState}" IsEnabled="False" />
                                <MenuItem Header="{x:Static s:Strings.ServiceRunning}" CommandParameter="Running" IsCheckable="True" StaysOpenOnClick="True" Click="ServicesFilterItem_Click" />
                                <MenuItem Header="{x:Static s:Strings.ServiceStopped}" CommandParameter="Stopped" IsCheckable="True" StaysOpenOnClick="True" Click="ServicesFilterItem_Click" />
                                <Separator />
                                <MenuItem Header="{x:Static s:Strings.ServicesFilterReset}" Click="ServicesFilterReset_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="{x:Static s:Strings.ServicesHint}">
                        <TextBlock Style="{StaticResource Muted}" Text="{x:Static s:Strings.ServicesHintShort}" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource InfoGlyph}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
            <Grid>
                <ListBox x:Name="ServicesList" Background="Transparent" BorderThickness="0" Padding="0,0,24,0"
                         ItemContainerStyle="{StaticResource PassiveItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="1,2" VirtualizingPanel.CacheLengthUnit="Page"
                         AutomationProperties.Name="{x:Static s:Strings.TabServices}"
                         Focusable="False" KeyboardNavigation.TabNavigation="Continue">
                    <!-- The rows are not selectable; Tab walks through their controls: show and hide, start type, start, stop, restart -->
                    <ListBox.Resources>
                        <DataTemplate DataType="{x:Type ui:ServiceHeader}">
                            <Grid Margin="0,12,0,6" Height="32">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" ToolTip="{Binding Tip}">
                                    <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding Title}" />
                                    <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding Count}" Margin="8,0,0,0" />
                                    <TextBlock Style="{StaticResource InfoGlyph}" FontSize="11" />
                                </StackPanel>
                                <Button Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Content="{Binding ToggleText}" Click="ServiceSection_Click"
                                        Visibility="{Binding CanFold, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type ui:ServiceVm}">
                            <Border Height="60" Margin="0,0,0,6" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Line}"
                                    Background="{DynamicResource Surface}" Padding="16,0,8,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" ToolTip="{Binding Tip}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text1}" TextTrimming="CharacterEllipsis" />
                                            <Border Style="{StaticResource Chip}" Margin="8,0,0,0" ToolTip="{Binding KindTip}"
                                                    Visibility="{Binding IsWindows, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding KindChip}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ChipLabel}">
                                                            <Setter Property="Foreground" Value="{DynamicResource Text3}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Essential}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource WarnText}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource Text4}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource Chip}" Width="118" Margin="12,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource Text4}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                <Setter Property="Fill" Value="#2F9E44" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Style="{StaticResource ChipLabel}" Foreground="{DynamicResource Text2}" Text="{Binding StateText}" />
                                        </StackPanel>
                                    </Border>
                                    <Grid Grid.Column="2" Width="196" VerticalAlignment="Center">
                                        <ComboBox ItemsSource="{x:Static ui:ServiceVm.StartTypes}" SelectedIndex="{Binding StartIndex, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanChangeStart}" Height="32" FontSize="13"
                                                  AutomationProperties.Name="{x:Static s:Strings.ServiceStartType}" ToolTip="{x:Static s:Strings.ServiceStartTypeTip}" />
                                    </Grid>
                                    <!-- Always takes its room, so the start type lines up in every row -->
                                    <Grid Grid.Column="3" Width="20" Margin="6,0,0,0">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE945;" FontSize="12" Foreground="{DynamicResource Text4}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip="{x:Static s:Strings.ServiceTriggerTip}"
                                                   Visibility="{Binding HasTrigger, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                    <StackPanel Grid.Column="4" Style="{StaticResource RowActions}" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <Button Style="{StaticResource RowAction}" Content="&#xE768;" IsEnabled="{Binding CanStart}" Click="ServiceStart_Click"
                                                ToolTip="{x:Static s:Strings.ServiceStart}" AutomationProperties.Name="{x:Static s:Strings.ServiceStart}" />
                                        <Button Style="{StaticResource RowAction}" Content="&#xE71A;" IsEnabled="{Binding CanStop}" Click="ServiceStop_Click"
                                                ToolTip="{x:Static s:Strings.ServiceStop}" AutomationProperties.Name="{x:Static s:Strings.ServiceStop}" />
                                        <Button Style="{StaticResource RowAction}" Content="&#xE72C;" IsEnabled="{Binding CanRestart}" Click="ServiceRestart_Click"
                                                ToolTip="{x:Static s:Strings.ServiceRestart}" AutomationProperties.Name="{x:Static s:Strings.ServiceRestart}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.Resources>
                </ListBox>
                <TextBlock x:Name="ServicesLoading" Style="{StaticResource Muted}" Text="{x:Static s:Strings.ServicesLoading}" HorizontalAlignment="Left" VerticalAlignment="Top" />
            </Grid>
        </DockPanel>

        <!-- ========== Settings ========== -->        <!-- Every card: title and one line of context, then rows with the label left and the control right -->
        <ScrollViewer x:Name="SettingsView" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Margin="0,0,4,20">
            <StackPanel Margin="32,24,28,4" MaxWidth="820">

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource CardHeader}" Orientation="Horizontal" ToolTip="{x:Static s:Strings.SettingsAppearanceHelp}"><TextBlock Style="{StaticResource CardTitle}" Text="{x:Static s:Strings.SettingsAppearance}" /><TextBlock Style="{StaticResource InfoGlyph}" /></StackPanel>
                        <Border Style="{StaticResource Divider}" />
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource SettingText}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="{x:Static s:Strings.SettingsTheme}" />
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource SegmentGroup}">
                                <StackPanel kit:KitKeys.Roving="True" Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource FirstSegment}" GroupName="Theme" Content="{x:Static s:Strings.ThemeSystem}" IsChecked="{Binding ThemeSystem}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Theme" Content="{x:Static s:Strings.ThemeLight}" IsChecked="{Binding ThemeLight}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Theme" Content="{x:Static s:Strings.ThemeDark}" IsChecked="{Binding ThemeDark}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource Divider}" />
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource SettingText}" Orientation="Horizontal" ToolTip="{x:Static kit:AccentRow.Help}"><TextBlock Style="{StaticResource RowLabel}" Text="{x:Static kit:AccentRow.Label}" /><TextBlock Style="{StaticResource InfoGlyph}" /></StackPanel>
                            <!-- The family's segments (StartQueue, Profile, Windows, Sand) from the kit's AccentRow, set when the settings open -->
                            <ContentControl x:Name="AccentHost" Grid.Column="1" Focusable="False" />
                        </Grid>
                        <Border Style="{StaticResource Divider}" />
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource SettingText}" Orientation="Horizontal" ToolTip="{x:Static s:Strings.LanguageHelp}"><TextBlock Style="{StaticResource RowLabel}" Text="{x:Static s:Strings.SettingsLanguage}" /><TextBlock Style="{StaticResource InfoGlyph}" /></StackPanel>
                            <!-- A list that may grow: a drop-down, as in every app of the family -->
                            <ComboBox Grid.Column="1" Width="260" Height="32" FontSize="13" VerticalAlignment="Center" SelectedIndex="{Binding LanguageIndex}"
                                      AutomationProperties.Name="{x:Static s:Strings.SettingsLanguage}">
                                <ComboBoxItem Content="{x:Static s:Strings.LanguageSystem}" />
                                <ComboBoxItem Content="English" />
                                <ComboBoxItem Content="Deutsch" />
                            </ComboBox>
                        </Grid>
                        <Border Style="{StaticResource Divider}" />
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- How StartQueue is set up, what that means below it, and "Set up fully" (one UAC prompt) when there is a step up -->
                            <StackPanel Style="{StaticResource SettingText}">
                                <StackPanel Orientation="Horizontal" Background="Transparent" HorizontalAlignment="Left" ToolTip="{Binding ModeText}"><TextBlock Style="{StaticResource RowLabel}" Text="{Binding ModeTitle}" /><TextBlock Style="{StaticResource InfoGlyph}" VerticalAlignment="Center" /></StackPanel>
                                <TextBlock Style="{StaticResource Help}" Text="{Binding SetupStateText}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Click="SetUpAdmin_Click"
                                    Visibility="{Binding CanSetUpAdmin, Converter={StaticResource BoolToVisibility}}" ToolTip="{x:Static s:Strings.SetUpAdminTip}"
                                    AutomationProperties.Name="{x:Static s:Strings.SetUpAdmin}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xEA18;" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Static s:Strings.SetUpAdmin}" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="SequenceCard" Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource CardHeader}" Orientation="Horizontal" ToolTip="{x:Static s:Strings.SettingsSequenceHelp}"><TextBlock Style="{StaticResource CardTitle}" Text="{x:Static s:Strings.SettingsSequence}" /><TextBlock Style="{StaticResource InfoGlyph}" /></StackPanel>
                        <Border Style="{StaticResource Divider}" />
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource SettingText}" Orientation="Horizontal" ToolTip="{x:Static s:Strings.SettingsStartDelayHelp}"><TextBlock Style="{StaticResource RowLabel}" Text="{x:Static s:Strings.SettingsStartDelay}" /><TextBlock Style="{StaticResource InfoGlyph}" /></StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox Style="{StaticResource FieldBox}" Width="64" Text="{Binding StartDelaySeconds, UpdateSourceTrigger=LostFocus}" KeyDown="CommitOnEnter"
                                         AutomationProperties.Name="{x:Static s:Strings.SettingsStartDelay}" />
                                <TextBlock Text="{x:Static s:Strings.Seconds}" Width="64" Margin="8,0,0,0" FontSize="13" Foreground="{DynamicResource Text3}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource Divider}" />
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource SettingText}" Orientation="Horizontal" ToolTip="{x:Static s:Strings.SettingsGapHelp}"><TextBlock Style="{StaticResource RowLabel}" Text="{x:Static s:Strings.SettingsGap}" /><TextBlock Style="{StaticResource InfoGlyph}" /></StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox Style="{StaticResource FieldBox}" Width="64" Text="{Binding GapSeconds, UpdateSourceTrigger=LostFocus}" KeyDown="CommitOnEnter"
                                         AutomationProperties.Name="{x:Static s:Strings.SettingsGap}" />
                                <TextBlock Text="{x:Static s:Strings.Seconds}" Width="64" Margin="8,0,0,0" FontSize="13" Foreground="{DynamicResource Text3}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource Divider}" />
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource SettingText}" Orientation="Horizontal" ToolTip="{x:Static s:Strings.SettingsWaitLimitHelp}"><TextBlock Style="{StaticResource RowLabel}" Text="{x:Static s:Strings.SettingsWaitLimit}" /><TextBlock Style="{StaticResource InfoGlyph}" /></StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox Style="{StaticResource FieldBox}" Width="64" Text="{Binding WaitLimitSeconds, UpdateSourceTrigger=LostFocus}" KeyDown="CommitOnEnter"
                                         AutomationProperties.Name="{x:Static s:Strings.SettingsWaitLimit}" />
                                <TextBlock Text="{x:Static s:Strings.Seconds}" Width="64" Margin="8,0,0,0" FontSize="13" Foreground="{DynamicResource Text3}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource Divider}" />
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource SettingText}" Orientation="Horizontal" ToolTip="{x:Static s:Strings.SettingsNotifySequenceHelp}"><TextBlock Style="{StaticResource RowLabel}" Text="{x:Static s:Strings.SettingsNotifySequence}" /><TextBlock Style="{StaticResource InfoGlyph}" /></StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding NotifyAfterSequence}" VerticalAlignment="Center"
                                      AutomationProperties.Name="{x:Static s:Strings.SettingsNotifySequence}" />
                        </Grid>
                        <Border Style="{StaticResource Divider}" />
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource SettingText}" Orientation="Horizontal" ToolTip="{x:Static s:Strings.WindowsDelayHelp}"><TextBlock Style="{StaticResource RowLabel}" Text="{x:Static s:Strings.WindowsDelayOff}" /><TextBlock Style="{StaticResource InfoGlyph}" /></StackPanel>
                            <!-- Asks first (Click), so the binding only shows the state -->
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding WindowsDelayOff, Mode=OneWay}" VerticalAlignment="Center"
                                      Click="WindowsDelay_Click" AutomationProperties.Name="{x:Static s:Strings.WindowsDelayOff}" />
                        </Grid>
                        <Border Style="{StaticResource Divider}" />
                        <!-- Shutting down with prepared apps: what Windows allows here, and one button to set it up or undo it -->
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource SettingText}">
                                <StackPanel Orientation="Horizontal" ToolTip="{x:Static s:Strings.SettingsPreparedHelp}"><TextBlock Style="{StaticResource RowLabel}" Text="{x:Static s:Strings.SettingsPrepared}" /><TextBlock Style="{StaticResource InfoGlyph}" /></StackPanel>
                                <TextBlock Style="{StaticResource Help}" Text="{Binding PreparedText}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="PreparedButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Margin="16,0,0,0"
                                    Content="{Binding PreparedButton}" Click="Prepared_Click"
                                    Visibility="{Binding PreparedCanAct, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource CardHeader}" Orientation="Horizontal" ToolTip="{x:Static s:Strings.SettingsNewMode}"><TextBlock Style="{StaticResource CardTitle}" Text="{x:Static s:Strings.SettingsNewEntries}" /><TextBlock Style="{StaticResource InfoGlyph}" /></StackPanel>
                        <!-- Negative margin: the radio circles line up with the text above -->
                        <StackPanel Margin="-12,0,-12,8">
                            <RadioButton Style="{StaticResource RadioCard}" GroupName="NewMode" Content="{x:Static s:Strings.NewModeEnabled}" Tag="{x:Static s:Strings.ModeEnabledHelp}" IsChecked="{Binding ModeEnabled}" />
                            <RadioButton Style="{StaticResource RadioCard}" GroupName="NewMode" Content="{x:Static s:Strings.NewModeDisabled}" Tag="{x:Static s:Strings.ModeDisabledHelp}" IsChecked="{Binding ModeDisabled}" />
                            <RadioButton Style="{StaticResource RadioCard}" GroupName="NewMode" Content="{x:Static s:Strings.NewModeNotify}" Tag="{x:Static s:Strings.ModeNotifyHelp}" IsChecked="{Binding ModeNotify}" />
                        </StackPanel>
                        <Border Style="{StaticResource Divider}" />
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource SettingText}" Orientation="Horizontal" ToolTip="{x:Static s:Strings.NotifyHelpShort}"><TextBlock Style="{StaticResource RowLabel}" Text="{x:Static s:Strings.SettingsNotifyNew}" /><TextBlock Style="{StaticResource InfoGlyph}" /></StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding NotifyNewEntries}" VerticalAlignment="Center"
                                      AutomationProperties.Name="{x:Static s:Strings.SettingsNotifyNew}" />
                        </Grid>
                        <Border Style="{StaticResource Divider}" />
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource SettingText}" Orientation="Horizontal" ToolTip="{x:Static s:Strings.SettingsStoreAppsHelp}"><TextBlock Style="{StaticResource RowLabel}" Text="{x:Static s:Strings.SettingsStoreApps}" /><TextBlock Style="{StaticResource InfoGlyph}" /></StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ManageStoreApps}" VerticalAlignment="Center"
                                      AutomationProperties.Name="{x:Static s:Strings.SettingsStoreApps}" />
                        </Grid>
                        <Border Style="{StaticResource Divider}" />
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource SettingText}" Orientation="Horizontal" ToolTip="{x:Static s:Strings.SettingsScanHelp}"><TextBlock Style="{StaticResource RowLabel}" Text="{x:Static s:Strings.SettingsScanInterval}" /><TextBlock Style="{StaticResource InfoGlyph}" /></StackPanel>
                            <!-- Five segments as wide as the three of the appearance card (5 x 81.6 = 3 x 136) -->
                            <Border Grid.Column="1" Style="{StaticResource SegmentGroup}">
                                <StackPanel kit:KitKeys.Roving="True" Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource FirstSegment}" Width="81.6" GroupName="Scan" Content="5 min" IsChecked="{Binding Scan5}" />
                                    <RadioButton Style="{StaticResource Segment}" Width="81.6" GroupName="Scan" Content="10 min" IsChecked="{Binding Scan10}" />
                                    <RadioButton Style="{StaticResource Segment}" Width="81.6" GroupName="Scan" Content="30 min" IsChecked="{Binding Scan30}" />
                                    <RadioButton Style="{StaticResource Segment}" Width="81.6" GroupName="Scan" Content="60 min" IsChecked="{Binding Scan60}" />
                                    <RadioButton Style="{StaticResource Segment}" Width="81.6" GroupName="Scan" Content="{x:Static s:Strings.Never}" IsChecked="{Binding ScanNever}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- About, Troubleshooting and More from EsteemWorks: the family's cards, built by AboutPage -->
                <StackPanel x:Name="AboutHost" />
            </StackPanel>
        </ScrollViewer>

        <!-- ========== The kit's notifications (KitNotices), among them Undo after removing an app ========== -->
        <Grid x:Name="NoticeLayer" />

        <!-- ========== Overlay for in-app dialogs ========== -->
        </kit:KitFrame>

        <!-- Shut down and restart with prepared apps, one pair left of the gear on the tab line; the code moves it there -->
        <Border x:Name="PreparedPair" Style="{StaticResource HeroPair}" HorizontalAlignment="Right" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource HeroPairButton}" Content="&#xE7E8;" Click="ShutDownPrepared_Click"
                        ToolTip="{x:Static s:Strings.TrayShutDownPrepared}" AutomationProperties.Name="{x:Static s:Strings.TrayShutDownPrepared}" />
                <Rectangle Width="1" Fill="{DynamicResource HeroLine}" Margin="0,6" />
                <Button Style="{StaticResource HeroPairButton}" Content="&#xE777;" Click="RestartPrepared_Click"
                        ToolTip="{x:Static s:Strings.TrayRestartPrepared}" AutomationProperties.Name="{x:Static s:Strings.TrayRestartPrepared}" />
            </StackPanel>
        </Border>

        <Popup x:Name="ScanResult" PlacementTarget="{Binding ElementName=ScanButton}" Placement="Custom" AllowsTransparency="True" StaysOpen="True">
            <!-- shadow-pop in two layers: the far one around the card, the near one on it. Grows out of the Scan button -->
            <Border x:Name="ScanResultFrame" Margin="16,4,16,24" Effect="{DynamicResource ShadowPopFar}">
                <Border x:Name="ScanResultCard" CornerRadius="8" Background="{DynamicResource Pop}" BorderBrush="{DynamicResource PopLine}" BorderThickness="1"
                        Padding="12,10,16,10" MaxWidth="380" MouseLeftButtonUp="ScanResult_Click" Cursor="Hand" Effect="{DynamicResource ShadowPopNear}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ScanResultIcon" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Top" Margin="0,2,8,0" />
                        <TextBlock x:Name="ScanResultText" Grid.Column="1" FontSize="13" LineHeight="19" Foreground="{DynamicResource Text1}" TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </Border>
        </Popup>
        <!-- ========== Dialogs in the window; Tab stays inside while one is open ========== -->
        <Grid x:Name="Overlay" Background="{DynamicResource Overlay}" Visibility="Collapsed" KeyDown="Overlay_KeyDown"
              KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">

            <!-- Confirm / message -->
            <!-- shadow-dialog in two layers (the kit's ShadowDialogFar and ShadowDialogNear). Shadows sit on separate,
                 empty borders: an effect on the card itself would redraw the whole card on every change -->
            <Border Width="{Binding ActualWidth, ElementName=ConfirmCard}" Margin="24" CornerRadius="10" Background="{DynamicResource Pop}" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Height="{Binding ActualHeight, ElementName=ConfirmCard}" Visibility="{Binding Visibility, ElementName=ConfirmCard}"
                    Opacity="{Binding Opacity, ElementName=ConfirmCard}" RenderTransformOrigin="0.5,0.5" RenderTransform="{Binding RenderTransform, ElementName=ConfirmCard}"
                    Effect="{DynamicResource ShadowDialogFar}" />
            <Border Width="{Binding ActualWidth, ElementName=ConfirmCard}" Margin="24" CornerRadius="10" Background="{DynamicResource Pop}" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Height="{Binding ActualHeight, ElementName=ConfirmCard}" Visibility="{Binding Visibility, ElementName=ConfirmCard}"
                    Opacity="{Binding Opacity, ElementName=ConfirmCard}" RenderTransformOrigin="0.5,0.5" RenderTransform="{Binding RenderTransform, ElementName=ConfirmCard}"
                    Effect="{DynamicResource ShadowDialogNear}" />
            <Border x:Name="ConfirmCard" Width="440" Margin="24" CornerRadius="10" Background="{DynamicResource Pop}" BorderBrush="{DynamicResource PopLine}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Margin="24,24,24,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ConfirmIconBox" Width="36" Height="36" CornerRadius="8" HorizontalAlignment="Left">
                                <TextBlock x:Name="ConfirmIcon" FontFamily="{StaticResource IconFont}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="ConfirmTitle" Grid.Column="1" Style="{StaticResource DialogTitle}" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="ConfirmBody" FontSize="14" Foreground="{DynamicResource Text2}" TextWrapping="Wrap" Margin="0,12,0,0" />
                        <TextBlock x:Name="ConfirmNote" Style="{StaticResource Muted}" Margin="0,8,0,0" />
                    </StackPanel>
                    <Border Background="{DynamicResource Footer}" BorderBrush="{DynamicResource PopLine}" BorderThickness="0,1,0,0" CornerRadius="0,0,10,10" Padding="24,16">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="ConfirmCancel" Style="{StaticResource SecondaryButton}" Content="{x:Static s:Strings.Cancel}" Click="ConfirmCancel_Click" Margin="0,0,8,0" />
                            <!-- A second way on, only for a choice of three (ChooseAsync) -->
                            <Button x:Name="ConfirmSecond" Style="{StaticResource SecondaryButton}" Click="ConfirmSecond_Click" Margin="0,0,8,0" Visibility="Collapsed" />
                            <Button x:Name="ConfirmOk" Style="{StaticResource DangerButton}" Click="ConfirmOk_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Privacy and notices: headings and paragraphs filled in from code -->
            <!-- The far layer of shadow-dialog, behind the card; the near one sits on the card -->
            <Border Width="600" Margin="24" CornerRadius="10" Background="{DynamicResource Pop}" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Height="{Binding ActualHeight, ElementName=LegalCard}" Visibility="{Binding Visibility, ElementName=LegalCard}"
                    Opacity="{Binding Opacity, ElementName=LegalCard}" RenderTransformOrigin="0.5,0.5" RenderTransform="{Binding RenderTransform, ElementName=LegalCard}"
                    Effect="{DynamicResource ShadowDialogFar}" IsHitTestVisible="False" />
            <Border x:Name="LegalCard" Width="600" Margin="24" CornerRadius="10" Background="{DynamicResource Pop}" BorderBrush="{DynamicResource PopLine}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Effect="{DynamicResource ShadowDialogNear}">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Footer}" BorderBrush="{DynamicResource PopLine}" BorderThickness="0,1,0,0" CornerRadius="0,0,10,10" Padding="24,16">
                        <Button Style="{StaticResource PrimaryButton}" Content="{x:Static s:Strings.Close}" Click="DialogCancel_Click" HorizontalAlignment="Right" />
                    </Border>
                    <TextBlock x:Name="InfoTitle" DockPanel.Dock="Top" Style="{StaticResource DialogTitle}" Margin="24,24,24,8" />
                    <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto" Padding="24,0,16,20">
                        <StackPanel x:Name="LegalContent" Margin="0,0,8,0" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Profile: name, days, time. Small and fixed, so the shadow may sit on the card itself. -->
            <!-- The far layer of shadow-dialog, behind the card; the near one sits on the card -->
            <Border Width="460" Margin="24" CornerRadius="10" Background="{DynamicResource Pop}" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Height="{Binding ActualHeight, ElementName=ProfileCard}" Visibility="{Binding Visibility, ElementName=ProfileCard}"
                    Opacity="{Binding Opacity, ElementName=ProfileCard}" RenderTransformOrigin="0.5,0.5" RenderTransform="{Binding RenderTransform, ElementName=ProfileCard}"
                    Effect="{DynamicResource ShadowDialogFar}" IsHitTestVisible="False" />
            <Border x:Name="ProfileCard" Width="460" Margin="24" CornerRadius="10" Background="{DynamicResource Pop}" BorderBrush="{DynamicResource PopLine}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Effect="{DynamicResource ShadowDialogNear}">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Footer}" BorderBrush="{DynamicResource PopLine}" BorderThickness="0,1,0,0" CornerRadius="0,0,10,10" Padding="24,16">
                        <Grid>
                            <Button x:Name="ProfileDeleteButton" Style="{StaticResource GhostButton}" Foreground="{DynamicResource ErrorText}"
                                    Content="{x:Static s:Strings.ProfileDelete}" HorizontalAlignment="Left" Click="ProfileDelete_Click" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource SecondaryButton}" Content="{x:Static s:Strings.Cancel}" Click="DialogCancel_Click" Margin="0,0,8,0" />
                                <Button Style="{StaticResource PrimaryButton}" Content="{x:Static s:Strings.Save}" Click="ProfileSave_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel Margin="24,24,24,20">
                            <TextBlock x:Name="ProfileTitle" Style="{StaticResource DialogTitle}" />
                            <!-- Name, color, days, time, outside the hours, for all apps: the family's shared part (EsteemWorks.Kit ProfileFields) -->
                            <ContentControl x:Name="ProfileFieldsHost" Focusable="False" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Order of the profiles: one below the other, top wins, Standard at the bottom -->
            <!-- The far layer of shadow-dialog, behind the card; the near one sits on the card -->
            <Border Width="520" Margin="24" CornerRadius="10" Background="{DynamicResource Pop}" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Height="{Binding ActualHeight, ElementName=ProfileOrderCard}" Visibility="{Binding Visibility, ElementName=ProfileOrderCard}"
                    Opacity="{Binding Opacity, ElementName=ProfileOrderCard}" RenderTransformOrigin="0.5,0.5" RenderTransform="{Binding RenderTransform, ElementName=ProfileOrderCard}"
                    Effect="{DynamicResource ShadowDialogFar}" IsHitTestVisible="False" />
            <Border x:Name="ProfileOrderCard" Width="520" Margin="24" CornerRadius="10" Background="{DynamicResource Pop}" BorderBrush="{DynamicResource PopLine}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Effect="{DynamicResource ShadowDialogNear}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="24,24,24,16" ToolTip="{x:Static s:Strings.ProfileOrderHelp}">
                        <TextBlock Style="{StaticResource DialogTitle}" Text="{x:Static s:Strings.ProfileOrderTitle}" />
                        <TextBlock Style="{StaticResource InfoGlyph}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Footer}" BorderBrush="{DynamicResource PopLine}" BorderThickness="0,1,0,0" CornerRadius="0,0,10,10" Padding="24,16">
                        <Button Style="{StaticResource PrimaryButton}" Content="{x:Static s:Strings.DoneEditing}" Click="DialogCancel_Click" HorizontalAlignment="Right" />
                    </Border>
                    <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto" Padding="24,0,16,16">
                        <Grid Margin="0,0,8,0">
                            <ItemsControl x:Name="ProfileOrderList" Focusable="False" AllowDrop="True" Background="Transparent"
                                          DragOver="ProfileOrder_DragOver" Drop="ProfileOrder_Drop" DragLeave="ProfileOrder_DragLeave">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="56" Margin="0,0,0,6" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Surface}"
                                                Padding="8,0,8,0" PreviewMouseLeftButtonDown="ProfileOrderRow_PreviewMouseDown" PreviewMouseMove="ProfileOrderRow_PreviewMouseMove">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Cursor" Value="SizeAll" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCustom}" Value="False">
                                                            <Setter Property="Cursor" Value="Arrow" />
                                                            <Setter Property="Opacity" Value="0.75" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="22" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE76F;" FontSize="12" Foreground="{DynamicResource Text4}" VerticalAlignment="Center"
                                                           Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Rank}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text3}" VerticalAlignment="Center" />
                                                <Grid Grid.Column="2" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Ellipse Width="8" Height="8" Fill="{Binding Swatch}" />
                                                    <Ellipse Stroke="{Binding Swatch}" StrokeThickness="1.5" Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                                                </Grid>
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="4,0,8,0">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text1}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource Text4}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"
                                                            Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibility}}">
                                                    <Button Style="{StaticResource IconButton}" Content="&#xE70E;" FontSize="11" IsEnabled="{Binding CanUp}" Click="ProfileOrderUp_Click"
                                                            ToolTip="{x:Static s:Strings.ProfileEarlierTip}" AutomationProperties.Name="{x:Static s:Strings.ProfileEarlierTip}" />
                                                    <Button Style="{StaticResource IconButton}" Content="&#xE70D;" FontSize="11" IsEnabled="{Binding CanDown}" Click="ProfileOrderDown_Click"
                                                            ToolTip="{x:Static s:Strings.ProfileLaterTip}" AutomationProperties.Name="{x:Static s:Strings.ProfileLaterTip}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Where a dragged profile will land, as in the list of apps -->
                            <Canvas x:Name="ProfileOrderDropLayer" IsHitTestVisible="False">
                                <Grid x:Name="ProfileOrderMarker" Height="10" Visibility="Collapsed">
                                    <Border Height="2" CornerRadius="1" Background="{DynamicResource AccentFill}" VerticalAlignment="Center" Margin="5,0,0,0" />
                                    <Ellipse Width="10" Height="10" HorizontalAlignment="Left" Stroke="{DynamicResource AccentFill}" StrokeThickness="2" Fill="{DynamicResource Pop}" />
                                </Grid>
                            </Canvas>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Pause a profile: from now, for a planned span, or until resumed; all day or with times -->
            <!-- The far layer of shadow-dialog, behind the card; the near one sits on the card -->
            <Border Width="460" Margin="24" CornerRadius="10" Background="{DynamicResource Pop}" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Height="{Binding ActualHeight, ElementName=PauseCard}" Visibility="{Binding Visibility, ElementName=PauseCard}"
                    Opacity="{Binding Opacity, ElementName=PauseCard}" RenderTransformOrigin="0.5,0.5" RenderTransform="{Binding RenderTransform, ElementName=PauseCard}"
                    Effect="{DynamicResource ShadowDialogFar}" IsHitTestVisible="False" />
            <Border x:Name="PauseCard" Width="460" Margin="24" CornerRadius="10" Background="{DynamicResource Pop}" BorderBrush="{DynamicResource PopLine}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Effect="{DynamicResource ShadowDialogNear}">
                <StackPanel>
                    <StackPanel Margin="24,24,24,20">
                        <TextBlock x:Name="PauseTitleText" Style="{StaticResource DialogTitle}" />
                        <!-- From now, a period or until resumed: the family's shared part (EsteemWorks.Kit ProfilePauseFields) -->
                        <ContentControl x:Name="PauseFieldsHost" Focusable="False" />
                    </StackPanel>
                    <Border Background="{DynamicResource Footer}" BorderBrush="{DynamicResource PopLine}" BorderThickness="0,1,0,0" CornerRadius="0,0,10,10" Padding="24,16">
                        <Grid>
                            <Button x:Name="PauseRemoveButton" Style="{StaticResource GhostButton}" Foreground="{DynamicResource ErrorText}"
                                    Content="{x:Static s:Strings.PauseRemove}" HorizontalAlignment="Left" Click="PauseRemove_Click" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource SecondaryButton}" Content="{x:Static s:Strings.Cancel}" Click="DialogCancel_Click" Margin="0,0,8,0" />
                                <Button Style="{StaticResource PrimaryButton}" Content="{x:Static s:Strings.Save}" Click="PauseConfirm_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Add app -->
            <Border Width="600" MaxHeight="640" Margin="24" CornerRadius="10" Background="{DynamicResource Pop}" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                    Visibility="{Binding Visibility, ElementName=AddCard}"
                    Opacity="{Binding Opacity, ElementName=AddCard}" RenderTransformOrigin="0.5,0.5" RenderTransform="{Binding RenderTransform, ElementName=AddCard}"
                    Effect="{DynamicResource ShadowDialogFar}" />
            <Border Width="600" MaxHeight="640" Margin="24" CornerRadius="10" Background="{DynamicResource Pop}" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                    Visibility="{Binding Visibility, ElementName=AddCard}"
                    Opacity="{Binding Opacity, ElementName=AddCard}" RenderTransformOrigin="0.5,0.5" RenderTransform="{Binding RenderTransform, ElementName=AddCard}"
                    Effect="{DynamicResource ShadowDialogNear}" />
            <!-- Stretch with a maximum height: centered, but in a small window it keeps its distance to the edges -->
            <Border x:Name="AddCard" Width="600" MaxHeight="640" Margin="24" CornerRadius="10" Background="{DynamicResource Pop}" BorderBrush="{DynamicResource PopLine}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Stretch" Visibility="Collapsed">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="24,24,24,8">
                        <Grid>
                            <TextBlock Style="{StaticResource DialogTitle}" Text="{x:Static s:Strings.PickerTitle}" VerticalAlignment="Center" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="11" HorizontalAlignment="Right" Click="AddClose_Click"
                                    ToolTip="{x:Static s:Strings.Close}" AutomationProperties.Name="{x:Static s:Strings.Close}" />
                        </Grid>
                        <!-- The kit's search field; empty, Esc goes on to the dialog and closes it -->
                        <kit:SearchBox x:Name="AddSearch" Margin="0,16,0,0" Placeholder="{x:Static s:Strings.SearchPlaceholder}" PassEscapeWhenEmpty="True"
                                       TextChanged="AddSearch_TextChanged" />
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Footer}" BorderBrush="{DynamicResource PopLine}" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,10,10" Padding="24,16">
                        <Grid>
                            <Button Style="{StaticResource GhostButton}" Padding="4,0" HorizontalAlignment="Left" Click="AddBrowse_Click"
                                    AutomationProperties.Name="{x:Static s:Strings.BrowseFile}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE838;" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Static s:Strings.BrowseFile}" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PrimaryButton}" Content="{x:Static s:Strings.DoneEditing}" HorizontalAlignment="Right" Click="AddClose_Click" />
                        </Grid>
                    </Border>
                    <Grid>
                        <!-- Virtualized, so opening builds only the visible rows. Scrolling counts pixels, not rows:
                             rows differ in height, and row-wise scrolling made the list jump back. -->
                        <ListBox x:Name="AddList" Background="Transparent" BorderThickness="0" Padding="24,0,24,8" Margin="0,8,4,0"
                                 ItemContainerStyle="{StaticResource PassiveItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="1,2" VirtualizingPanel.CacheLengthUnit="Page"
                                 AutomationProperties.Name="{x:Static s:Strings.PickerTitle}" />
                        <TextBlock x:Name="AddLoading" Style="{StaticResource Muted}" Text="{x:Static s:Strings.LoadingApps}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Starting point of scrolling with the middle mouse button (MiddleScroll) -->
        <Canvas IsHitTestVisible="False">
            <Grid x:Name="ScrollMarker" Width="28" Height="28" Visibility="Collapsed">
                <Ellipse Fill="{DynamicResource Pop}" Stroke="{DynamicResource ControlLine}" StrokeThickness="1" />
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70E;" FontSize="8" Foreground="{DynamicResource Text2}"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5,0,0" />
                <Ellipse Width="3" Height="3" Fill="{DynamicResource Text2}" />
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70D;" FontSize="8" Foreground="{DynamicResource Text2}"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5" />
            </Grid>
        </Canvas>
    </Grid>
</Window>
