<UserControl x:Class="StartQueue.UI.IntroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:StartQueue"
             xmlns:ui="clr-namespace:StartQueue.UI">
    <!-- The steps of the first start (Welcome, Take over, Switch on), shown by the kit's KitFrame.StartIntro, which brings
         the step line, the scrolling and the buttons. Nothing changes in Windows before "Switch StartQueue on". -->
    <Grid>

        <!-- ========== 1 Welcome ========== -->
        <StackPanel x:Name="WelcomePage">
            <TextBlock Style="{StaticResource H2}" TextWrapping="Wrap" Text="{x:Static s:Strings.IntroWelcomeTitle}" />
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="21" Foreground="{DynamicResource Text2}" Text="{x:Static s:Strings.IntroWelcomeText}" />
            <Border Style="{StaticResource Card}" Padding="24,4" Margin="0,16,0,16">
                <StackPanel>
                    <Grid Margin="0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8FD;" FontSize="20" Foreground="{DynamicResource Text3}" VerticalAlignment="Top" Margin="0,1,0,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Text1}" TextWrapping="Wrap" Text="{x:Static s:Strings.IntroPointListTitle}" />
                            <TextBlock Style="{StaticResource Help}" Margin="0,4,0,0" Text="{x:Static s:Strings.IntroPointListText}" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource Divider}" Margin="0" />
                    <Grid Margin="0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE823;" FontSize="20" Foreground="{DynamicResource Text3}" VerticalAlignment="Top" Margin="0,1,0,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Text1}" TextWrapping="Wrap" Text="{x:Static s:Strings.IntroPointFirstTitle}" />
                            <TextBlock Style="{StaticResource Help}" Margin="0,4,0,0" Text="{x:Static s:Strings.IntroPointFirstText}" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource Divider}" Margin="0" />
                    <Grid Margin="0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7A7;" FontSize="20" Foreground="{DynamicResource Text3}" VerticalAlignment="Top" Margin="0,1,0,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Text1}" TextWrapping="Wrap" Text="{x:Static s:Strings.IntroPointBackTitle}" />
                            <TextBlock Style="{StaticResource Help}" Margin="0,4,0,0" Text="{x:Static s:Strings.IntroPointBackText}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource NoticeBg}" CornerRadius="8" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE946;" FontSize="16" Foreground="{DynamicResource NoticeText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock x:Name="WelcomeFound" Grid.Column="1" FontSize="13" Foreground="{DynamicResource NoticeText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>

        <!-- ========== 2 Take over ========== -->
        <Grid x:Name="TakeOverPage" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource H2}" TextWrapping="Wrap" Text="{x:Static s:Strings.IntroTakeOverTitle}" />
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="21" Foreground="{DynamicResource Text2}" Text="{x:Static s:Strings.IntroTakeOverText}" />
            </StackPanel>
            <!-- Two columns as in the design: a wide step (IntroStep Wide), the list left, the two cards right -->
            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="0" Margin="0" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Margin="16,12">
                            <TextBlock x:Name="FoundLabel" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                            <TextBlock x:Name="ChosenText" Style="{StaticResource Help}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="NoneFound" Style="{StaticResource Muted}" Margin="16,0,16,16" TextWrapping="Wrap" Text="{x:Static s:Strings.IntroNoneFound}" Visibility="Collapsed" />
                        <ItemsControl x:Name="FoundList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type ui:IntroItem}">
                                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Chosen}" Margin="0,0,16,0" VerticalAlignment="Center"
                                                      AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding Path}" />
                                            <Image Grid.Column="1" Source="{Binding Icon}" Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Chosen}" Value="False">
                                                                <Setter Property="Opacity" Value="0.55" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text1}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Path}" FontSize="12" Foreground="{DynamicResource Text4}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Text="{Binding Where}" FontSize="12" Foreground="{DynamicResource Text3}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border x:Name="AllUsersCard" Style="{StaticResource Card}" Padding="16,12" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="AllUsersLabel" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                            <ItemsControl x:Name="AllUsersList" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72E;" FontSize="13" Foreground="{DynamicResource Text3}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding}" Margin="8,0,0,0" Foreground="{DynamicResource Text1}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="AllUsersText" Style="{StaticResource Help}" Margin="0,8,0,0" TextWrapping="Wrap" />
                            <Button x:Name="SetUpFullyButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="-12,8,0,4" Click="SetUpFully_Click"
                                    ToolTip="{x:Static s:Strings.IntroSetUpFullyTip}" AutomationProperties.Name="{x:Static s:Strings.IntroSetUpFully}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xEA18;" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Static s:Strings.IntroSetUpFully}" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="16,12,16,8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Margin="0,0,0,6" Text="{x:Static s:Strings.IntroLaterLabel}" />
                            <StackPanel Margin="-12,0,-12,0">
                                <RadioButton x:Name="ModeEnabled" Style="{StaticResource RadioCard}" GroupName="IntroMode" Content="{x:Static s:Strings.IntroModeEnabled}"
                                             Tag="{x:Static s:Strings.IntroModeEnabledHelp}" Checked="Mode_Checked" />
                                <RadioButton x:Name="ModeDisabled" Style="{StaticResource RadioCard}" GroupName="IntroMode" Content="{x:Static s:Strings.IntroModeDisabled}"
                                             Tag="{x:Static s:Strings.IntroModeDisabledHelp}" Checked="Mode_Checked" />
                                <RadioButton x:Name="ModeNotify" Style="{StaticResource RadioCard}" GroupName="IntroMode" Content="{x:Static s:Strings.IntroModeNotify}"
                                             Tag="{x:Static s:Strings.IntroModeNotifyHelp}" Checked="Mode_Checked" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ========== 3 Switch on ========== -->
        <StackPanel x:Name="ReadyPage" Visibility="Collapsed">
            <TextBlock Style="{StaticResource H2}" Text="{x:Static s:Strings.IntroReadyTitle}" />
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="21" Foreground="{DynamicResource Text2}" Text="{x:Static s:Strings.IntroReadyText}" />
            <Border Style="{StaticResource Card}" Padding="24,4" Margin="0,16,0,16">
                <Grid x:Name="ReadyRows">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="0,12" Foreground="{DynamicResource Text1}" Text="{x:Static s:Strings.IntroReadyStarts}" />
                    <ItemsControl x:Name="ReadyList" Grid.Column="1" Margin="0,12" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,4,16,4">
                                    <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource ChipBg}" VerticalAlignment="Center"
                                            Visibility="{Binding HasNumber, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding Number}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text2}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" Margin="8,0,0,0" Foreground="{DynamicResource Text1}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" />
                    <TextBlock Grid.Row="1" Margin="0,12" Foreground="{DynamicResource Text1}" Text="{x:Static s:Strings.IntroReadyWindows}" />
                    <TextBlock x:Name="ReadyWindows" Grid.Row="1" Grid.Column="1" Margin="0,12" Foreground="{DynamicResource Text2}" TextWrapping="Wrap" />
                    <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" />
                    <TextBlock Grid.Row="2" Margin="0,12" Foreground="{DynamicResource Text1}" Text="{x:Static s:Strings.IntroReadyNew}" />
                    <TextBlock x:Name="ReadyNew" Grid.Row="2" Grid.Column="1" Margin="0,12" Foreground="{DynamicResource Text2}" TextWrapping="Wrap" />
                    <Border Grid.Row="3" Grid.ColumnSpan="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" />
                    <TextBlock Grid.Row="3" Margin="0,12" Foreground="{DynamicResource Text1}" Text="{x:Static s:Strings.IntroReadySetUp}" />
                    <TextBlock x:Name="ReadySetUp" Grid.Row="3" Grid.Column="1" Margin="0,12" Foreground="{DynamicResource Text2}" TextWrapping="Wrap" />
                </Grid>
            </Border>
            <Border Background="{DynamicResource NoticeBg}" CornerRadius="8" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7A7;" FontSize="16" Foreground="{DynamicResource NoticeText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="1" FontSize="13" Foreground="{DynamicResource NoticeText}" TextWrapping="Wrap" VerticalAlignment="Center" Text="{x:Static s:Strings.IntroReadyGiveBack}" />
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
