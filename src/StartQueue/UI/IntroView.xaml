<UserControl x:Class="StartQueue.UI.IntroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:StartQueue"
             xmlns:ui="clr-namespace:StartQueue.UI">
    <!-- The steps of the first start (Welcome, Take over, Switch on), shown by the kit's KitFrame.StartIntro, which brings
         the step line, the scrolling and the buttons. Nothing changes in Windows before "Switch StartQueue on". -->
    <Grid>

        <!-- ========== 1 Welcome ========== -->
        <!-- The kit's pieces (IntroParts), filled in from code: heading, lead, features, the note -->
        <StackPanel x:Name="WelcomePage" />

        <!-- ========== 2 Take over ========== -->
        <Grid x:Name="TakeOverPage" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- Heading and lead from the kit (IntroParts) -->
            <StackPanel x:Name="TakeOverHead" MaxWidth="760" HorizontalAlignment="Left" />
            <!-- Two columns as in the design: a wide step (IntroStep Wide), the list left, the two cards right -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="0" Margin="0" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Margin="16,12">
                            <TextBlock x:Name="FoundLabel" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                            <TextBlock x:Name="ChosenText" Style="{StaticResource Help}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="NoneFound" Style="{StaticResource Muted}" Margin="16,0,16,16" TextWrapping="Wrap" Text="{x:Static s:Strings.IntroNoneFound}" Visibility="Collapsed" />
                        <ItemsControl x:Name="FoundList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type ui:IntroItem}">
                                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Chosen}" Margin="0,0,16,0" VerticalAlignment="Center"
                                                      AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding Path}" />
                                            <Image Grid.Column="1" Source="{Binding Icon}" Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Chosen}" Value="False">
                                                                <Setter Property="Opacity" Value="0.55" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text1}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Path}" FontSize="12" Foreground="{DynamicResource Text4}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Text="{Binding Where}" FontSize="12" Foreground="{DynamicResource Text3}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border x:Name="AllUsersCard" Style="{StaticResource Card}" Padding="16,12" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="AllUsersLabel" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                            <ItemsControl x:Name="AllUsersList" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72E;" FontSize="13" Foreground="{DynamicResource Text3}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding}" Margin="8,0,0,0" Foreground="{DynamicResource Text1}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="AllUsersText" Style="{StaticResource Help}" Margin="0,8,0,0" TextWrapping="Wrap" />
                            <!-- The kit's "Set up fully" (IntroParts.SetUpFully) -->
                            <ContentControl x:Name="SetUpFullyHost" Margin="-12,8,0,4" Focusable="False" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="16,12,16,8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Margin="0,0,0,6" Text="{x:Static s:Strings.IntroLaterLabel}" />
                            <StackPanel Margin="-12,0,-12,0">
                                <RadioButton x:Name="ModeEnabled" Style="{StaticResource RadioCard}" GroupName="IntroMode" Content="{x:Static s:Strings.IntroModeEnabled}"
                                             Tag="{x:Static s:Strings.IntroModeEnabledHelp}" Checked="Mode_Checked" />
                                <RadioButton x:Name="ModeDisabled" Style="{StaticResource RadioCard}" GroupName="IntroMode" Content="{x:Static s:Strings.IntroModeDisabled}"
                                             Tag="{x:Static s:Strings.IntroModeDisabledHelp}" Checked="Mode_Checked" />
                                <RadioButton x:Name="ModeNotify" Style="{StaticResource RadioCard}" GroupName="IntroMode" Content="{x:Static s:Strings.IntroModeNotify}"
                                             Tag="{x:Static s:Strings.IntroModeNotifyHelp}" Checked="Mode_Checked" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ========== 3 Switch on ========== -->
        <!-- The kit's pieces (IntroParts), filled in from code: heading, lead, the facts, the note -->
        <StackPanel x:Name="ReadyPage" Visibility="Collapsed" />
    </Grid>
</UserControl>
